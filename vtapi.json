<!doctype html>
<html lang="en">
   <head>
      <!-- Required meta tags -->
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	  <style>
        @font-face {
            font-family: "FF Mark";
            src: url("https://constellation-static.web.vanguard.com/v0/fonts/31b07b3f-1c2f-4320-90e5-bc52e0ed0b65.woff2") format("woff2"),
                 url("https://constellation-static.web.vanguard.com/v0/fonts/3eff48e2-1bfb-4565-82a4-2190f0e36a2c.woff") format("woff");
            font-weight: 400;
            font-style: normal;
        }

        @font-face {
            font-family: "FF Mark";
            src: url("https://constellation-static.web.vanguard.com/v0/fonts/30274a56-042d-447a-aff9-6da0dae01586.woff2") format("woff2"),
                 url("https://constellation-static.web.vanguard.com/v0/fonts/4b86a389-1f7f-4f7f-954c-402c06021ef6.woff") format("woff");
            font-weight: 700;
            font-style: normal;
        }

        @font-face {
            font-family: "FF Mark";
            src: url("https://constellation-static.web.vanguard.com/v0/fonts/dc1646ea-4041-4648-9540-0bd7cbd10dc1.woff2") format("woff2"),
                 url("https://constellation-static.web.vanguard.com/v0/fonts/27fe194e-39a0-45e2-9bbf-c9ee4f31495f.woff") format("woff");
            font-weight: 800;
            font-style: normal;
        }
		
		body {
			display: flex;
			flex-direction: column;
			min-height: 100vh;
		}
		
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		p {
			margin-bottom: 15px;
		}

		header {
			padding: 26px 0;
			background: #FFFFFF;
			border-bottom: 1px solid rgba(0, 0, 0, 0.15);
		}

		.header__logo {
			display: flex;
		}
		
		.logo {
            width: 127px;
            height: 27px;
        }
		
		.common_container {
			width: 100%;
			padding-left: 312px;
			padding-left: 312px;
		}
		
		@media only screen and (max-width: 1366px) {
			.common_container{
				padding-left: 144px;
				padding-right: 144px;
			}
		}
		
		@media only screen and (max-width: 992px) {
			.common_container{
				padding-left: 36px;
				padding-right: 36px;
			}
		}
		
		@media only screen and (max-width: 576px) {
			.common_container{
				padding-left: 12px;
				padding-right: 12px;
			}
		}
		
		.error_info {
			padding: 64px 0;
			flex-grow: 1;
		}
		
		@media only screen and (max-width: 576px) {
			.error_info{
				padding: 30px 0;
			}
		}
		
		.error_info__msg {
			width: 100%;
			max-width: 960px;
		}
		
		.error_info__msg_heading {
			font-family: 'FF Mark';
			font-style: normal;
			font-size: 46px;
			line-height: 48px;
			font-weight: 800;
			margin-bottom: 30px;
		}
		
		@media only screen and (max-width: 992px) {
			.error_info__msg_heading{
				font-size: 34px;
				line-height: 40px;
			}
		}
		
		.error_info__msg_description {
			font-family: 'FF Mark';
			font-style: normal;
			font-size: 17px;
			line-height: 24px;
			font-weight: 400;
			margin-bottom: 40px;
		}

		.error_info__altr_links {
			display: flex;
			gap: 150px;
		}

		@media only screen and (max-width: 576px) {
			.error_info__altr_links{
				gap: 30px;
				flex-direction: column;
				align-items: flex-start;
			}
		}

		.error_info__links_heading {
			font-family: 'FF Mark';
			font-style: normal;
			font-size: 17px;
			line-height: 24px;
			font-weight: 700;
			margin-bottom: 15px;
		}

		.error_info__quick_link {
			font-family: 'FF Mark';
			font-style: normal;
			font-size: 17px;
			line-height: 24px;
			font-weight: 700;
			text-decoration: none;
			color: #145BFF;
			background-image: linear-gradient(currentColor,currentColor);
			background-position: 0 100%;
			background-size: 0 1px;
			background-repeat: no-repeat;
			transition-property: background-size;
			transition-duration: .1s;
			transition-timing-function: cubic-bezier(.4,0,.2,1);
		}
		
		.error_info__quick_link:hover {
			background-size: 100% 1px;
			border-bottom: unset;
			color: #040505;
		}
		
		.error_info__quick_link:focus-visible {
		    background-size: 100% 1px;
			color: #040505;
			outline: 2px solid #0f62c5;
			outline-offset: 2px;
			border-radius: unset;
		}

		footer {
			width: 100%;
			bottom: 0;
			left: 0;
			background-color: #f5f6f6;
			padding-top: 20px;
			padding-bottom: 5px;
		}
		
		.footer__txt {
			font-family: 'FF Mark';
			font-style: normal;
			font-weight: 400;
			font-size: 14px;
			line-height: 20px;
		}
	  </style>
      <title>Service Unavailable | Vanguard</title>
