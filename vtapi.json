		 <script>
		    if (!document.location.href.includes("corporate-portal")) {
				document.getElementById("scriptResult").innerHTML=
                `<div class="error_info__links_one"><p class="error_info__links_heading">Log into your account</p>
                    ${addLink("https://logon.vanguard.com/logon", "Personal investors login")}
                </div>
                <div class="error_info__links_two"><p class="error_info__links_heading">Other Vanguard sites</p>
                    ${addLink("https://investor.vanguard.com/corporate-portal/", "See the list of other sites")}
                </div>`;
            }
            function addLink(linkAddress, name) {
                return `<p><a class="error_info__quick_link" href=${linkAddress}>${name}</a></p>`;
            }
        </script>
